# Copy this file to backend/.env and replace the placeholders. Never commit backend/.env.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>

# Application database (migrations and running the API).
# Local: database "officefix". Azure: use the server host, and add ?sslmode=require.
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@localhost:5432/officefix

# Separate database used only by the pytest suite. Must be a database whose name ends in _test.
# The suite truncates its tables before each test.
TEST_DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@localhost:5432/officefix_test

# Comma-separated frontend origins allowed by CORS. Must match the Vite dev server.
CORS_ORIGINS=http://localhost:5173
